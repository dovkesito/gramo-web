# Apple exige que el fichero de Universal Links se sirva como JSON, y no
# tiene extensión.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json

# Los paquetes de la app llevan el hash en el nombre: no cambian nunca.
/app/_expo/*
  Cache-Control: public, max-age=31536000, immutable
